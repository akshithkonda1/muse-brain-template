# .gitignore — Muse Brain

.DS_Store
*.swp
*~
__pycache__/
*.pyc
node_modules/
.env
*.key
*.pem
credentials*
*secret*

# Staging audit only — never push this file. It names the private
# brain and the person it was scrubbed from.
SCRUB-REPORT.md

# ML caches — generated locally, never committed.
ml/.cache/
*.npz
*.npy
*.pkl

# Downloadable packages built by scripts/package.py.
dist/

# Native-app build outputs (regenerated by CI / the build steps).
build/
dmg-staging/
windows-app/windows/
